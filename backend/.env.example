# Backend Environment Variables (.env)
# Copy this to backend/.env and fill in actual values
# NEVER commit this file to Git!

# ============================================================
# DJANGO SETTINGS
# ============================================================

DEBUG=False
SECRET_KEY=generate-with-python-secrets.token_urlsafe(50)
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ============================================================
# DATABASE
# ============================================================

# PostgreSQL Connection (Production/Render)
DATABASE_URL=postgresql://username:password@localhost:5432/unisinq_db

# Or individual PostgreSQL settings:
DB_NAME=unisinq_db
DB_USER=unisinq_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# ============================================================
# ALLOWED HOSTS & SECURITY
# ============================================================

ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com

# ============================================================
# EMAIL SERVICES
# ============================================================

# Brevo (Primary/Recommended)
BREVO_API_KEY=your_brevo_api_key_here
DEFAULT_FROM_EMAIL=noreply@unisinq.app

# Gmail SMTP (Fallback)
EMAIL_HOST_USER=your_gmail@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password_here

# Email backend will auto-select:
# 1. Brevo if BREVO_API_KEY is set
# 2. Gmail SMTP if EMAIL_HOST_USER & PASSWORD are set
# 3. Console (development) as fallback

# ============================================================
# OAUTH - SOCIAL LOGIN
# ============================================================

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ============================================================
# CORS - Frontend Communication
# ============================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=True

# ============================================================
# REDIS - For Caching & WebSocket (Optional)
# ============================================================

REDIS_URL=redis://localhost:6379/0

# ============================================================
# GOOGLE ANALYTICS
# ============================================================

GOOGLE_ANALYTICS_ID=G-K0PB5TRR26

# ============================================================
# EXTERNAL APIs
# ============================================================

# RapidAPI for University Lookup
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=universities-list.p.rapidapi.com

# ============================================================
# SSL/SECURITY (Production Only)
# ============================================================

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# For production, set these to True:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ============================================================
# SITE CONFIGURATION
# ============================================================

SITE_ID=1
LANGUAGE_CODE=en-us
TIME_ZONE=UTC

# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=INFO
